# Active ou désactive la connexion Twitch
TWITCH_ENABLED=true

# Application créée dans la console développeur Twitch
TWITCH_CLIENT_ID=fake_client_id
TWITCH_CLIENT_SECRET=fake_client_secret

# Identifiants numériques Twitch
TWITCH_BOT_ID=111111111
TWITCH_OWNER_ID=111111111
TWITCH_BROADCASTER_ID=111111111

# Noms Twitch en minuscules, sans @
TWITCH_BOT_LOGIN=ma_chaine
TWITCH_CHANNEL_LOGIN=ma_chaine

# Commandes du giveaway
TWITCH_COMMAND_PREFIX=!
